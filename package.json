{
  "name": "taskflow",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rls": "node --env-file=.env scripts/test-rls.mjs",
    "test:database": "node scripts/test-database.mjs",
    "test:cloud": "node --env-file=.env scripts/test-cloud-anonymous.mjs",
    "opencode": "node scripts/opencode.mjs",
    "format": "prettier --write src tests scripts vite.config.js opencode.json package.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "opencode-ai": "1.19.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
